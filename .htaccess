RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ /index.html [L]
RewriteRule ^praxis/?$ /about.html [L]
RewriteRule ^therapieangebote/?$ /service.html [L]
RewriteRule ^kontakt/?$ /contact.html [L]
RewriteRule ^impressum/?$ /impressum.html [L]
RewriteRule ^datenschutz/?$ /datenschutz.html [L]
RewriteRule ^agb/?$ /agb.html [L]
RewriteRule ^termin/?$ /appointment.html [L]
RewriteRule ^feature/?$ /feature.html [L]
RewriteRule ^blog/?$ /blog.html [L]
RewriteRule ^team/?$ /team.html [L]
RewriteRule ^testimonial/?$ /testimonial.html [L]
RewriteRule ^404/?$ /404.html [L]

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self'; connect-src 'self'; upgrade-insecure-requests"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
